NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Never put the service_role key in a NEXT_PUBLIC_ variable.

# Server-only. Used by app/api/admin/invite-teammate to call Supabase's
# admin.inviteUserByEmail — never sent to the browser. Find it in Supabase
# -> Project Settings -> API -> service_role (keep this secret).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Sentry error reporting. Create a project (platform: Next.js) in your Sentry
# org dashboard for tryentitle-portal specifically -- the DSN from your
# tryentitle-web project will NOT report errors from this app.
NEXT_PUBLIC_SENTRY_DSN=https://YOUR-KEY@oYOUR-ORG.ingest.us.sentry.io/YOUR-PROJECT-ID
SENTRY_DSN=https://YOUR-KEY@oYOUR-ORG.ingest.us.sentry.io/YOUR-PROJECT-ID
# Org/project slugs, used only at build time to upload source maps.
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
# Auth token for source-map upload during build (Sentry -> Settings -> Auth Tokens).
SENTRY_AUTH_TOKEN=YOUR-SENTRY-AUTH-TOKEN
